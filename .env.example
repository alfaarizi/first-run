# Local development configuration. Every value is a local-only default.

# The agent refuses to start without these three. compose.yaml provisions
# the same keys in Langfuse through LANGFUSE_INIT_*, so both sides agree.
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=lf_pk_local_dev
LANGFUSE_SECRET_KEY=lf_sk_local_dev

# Login for the local Langfuse UI at http://localhost:3000.
LANGFUSE_INIT_USER_EMAIL=local-dev@firstrun.local
LANGFUSE_INIT_USER_PASSWORD=lf_local_dev

# Server/ datastore credentials. init-postgres.sh provisions the role, compose
# and the host-run server both read these. Local-only, like the rest of this file.
POSTGRES_APP_USER=firstrun
POSTGRES_APP_PASSWORD=pg_local_dev
REDIS_PASSWORD=redis_local_dev

# Tasklet demo credentials, matching the app row scripts/seed.sql inserts.
# compose.yaml passes them to the container and Vite reads them via envDir.
VITE_FIRSTRUN_KEY=fr_pk_demo_tasklet
VITE_FIRSTRUN_HMAC_KEY=fr_sk_demo_tasklet

# The agent embeds crawled docs through Voyage AI. The placeholder starts
# the service; indexing needs a real key from dash.voyageai.com.
VOYAGE_API_KEY=vo_local_dev_placeholder
