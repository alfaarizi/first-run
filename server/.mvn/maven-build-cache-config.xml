<?xml version="1.0" encoding="UTF-8"?>
<!-- Off by default so local reruns always execute tests. CI opts in with
     -Dmaven.build.cache.enabled=true to skip builds whose inputs are unchanged. -->
<cache xmlns="http://maven.apache.org/BUILD-CACHE-CONFIG/1.2.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/BUILD-CACHE-CONFIG/1.2.0 https://maven.apache.org/xsd/build-cache-config-1.2.0.xsd">
  <configuration>
    <enabled>false</enabled>
  </configuration>
  <executionControl>
    <!-- A cached build records its test filters, so a run with different
         filters rebuilds instead of skipping tests the cache never ran. -->
    <reconcile>
      <plugins>
        <plugin artifactId="maven-surefire-plugin" goal="test">
          <reconciles>
            <reconcile propertyName="groups"/>
            <reconcile propertyName="excludedGroups"/>
          </reconciles>
        </plugin>
      </plugins>
    </reconcile>
  </executionControl>
</cache>
